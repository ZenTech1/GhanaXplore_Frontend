# FASTAPI backend base URL (Section 9.1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Google Maps API key (Section 9.1 — maps/GPS)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Paystack public key (Section 9.1 — payment gateway; frontend only ever
# sees the public key, all secret-key operations happen backend-side)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
